# Provider switch: if OPENAI_API_KEY is set, gpt-5.4-mini is used; otherwise claude-haiku-4-5.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Storage: postgres://... -> Supabase (prod); unset -> SQLite at DATABASE_PATH (local/tests)
DATABASE_URL=
DATABASE_PATH=./jarvis.db

# Google Calendar (optional — falls back to weekly template)
GOOGLE_CALENDAR_CREDENTIALS_JSON=./credentials.json
GOOGLE_CALENDAR_IDS=primary
# On the server (no disk): paste the CONTENTS of token.json instead
GOOGLE_TOKEN_JSON=

# Server (Render) — generate two long random strings for the tokens
TELEGRAM_WEBHOOK_SECRET=
RUN_TOKEN=
DASH_TOKEN=
WEBHOOK_MODE=
ONBOARDING_OPEN=0

# Langfuse tracing (optional — off when unset). EU region: also set LANGFUSE_HOST.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

PROMPT_VERSION=v2
