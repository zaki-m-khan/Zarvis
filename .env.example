# Provider switch: if OPENAI_API_KEY is set, gpt-5.4-mini is used; otherwise claude-haiku-4-5.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Path to Google OAuth desktop credentials JSON (optional — falls back to weekly template)
GOOGLE_CALENDAR_CREDENTIALS_JSON=./credentials.json
DATABASE_PATH=./jarvis.db
PROMPT_VERSION=v1
